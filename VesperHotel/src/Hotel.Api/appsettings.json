{
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "HotelDatabase": "Data Source=.local/vesper.db;Default Timeout=30" },
  "Jwt": { "Issuer": "VesperHotel", "Audience": "VesperHotel.Web" },
  "Seed": { "AdminEmail": "admin@vesper.local" },
  "Messaging": { "Mode": "Local" },
  "Kafka": { "BootstrapServers": "localhost:9092", "Topic": "vesper.bookings" },
  "Frontend": { "Url": "http://localhost:5173" },
  "Notifications": { "Directory": ".local/notifications" },
  "DataProtection": { "Directory": ".local/keys" },
  "Workers": { "RunInApi": true },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*"
}
